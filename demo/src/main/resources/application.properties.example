spring.application.name=bookstore-api
server.port=8080

# Relative to the demo/ directory when running the Maven command below.
# Provide an Access database with the project's Books, Categories, Users,
# Orders, OrderItems, OrderStatusHistory and Payments tables.
store.database.path=data/bookstore1.accdb

# Generate a unique 32-byte Base64 value and set JWT_SECRET in the shell.
app.security.jwt-secret=${JWT_SECRET}
app.security.jwt-issuer=bookstore-api
app.security.jwt-expiration-seconds=900
